# systemd user unit for outline-mcp SSOT-daemon mode (Linux).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/outline-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now outline-mcp
#
# Logs: journalctl --user -u outline-mcp -f

[Unit]
Description=outline-mcp — tree-structured knowledge base MCP server (streamable HTTP)
After=network.target

[Service]
# Books live in Postgres. Replace the placeholder with your database URL and
# run `outline-mcp migrate` against it once before enabling the unit: the
# server refuses to start on an unmigrated database. To keep the URL out of
# this file, use EnvironmentFile=%h/.config/outline-mcp/server.env instead.
Environment=OUTLINE_MCP_DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
ExecStart=%h/.cargo/bin/outline-mcp --mcp-http --bind 127.0.0.1:8486
# LAN exposure requires a token (startup is refused otherwise):
#   Environment=OUTLINE_MCP_HTTP_TOKEN=<random-string>
# and change --bind to 0.0.0.0:8486 in ExecStart.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
